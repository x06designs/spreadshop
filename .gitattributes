# PHPCS enforces LF (Generic.Files.LineEndings). Without this, a Windows checkout hands
# the sniff CRLF and the lint gate fails on files nobody edited.
*.php text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.dist text eol=lf
*.md text eol=lf
*.sh text eol=lf

*.png binary
*.pot text eol=lf
*.po text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.svg text eol=lf
