#: js/layout.js:165
msgid "Sizes"
msgstr "Größen"

#: includes/Admin/LayoutSection.php:101
msgid "Second image on hover"
msgstr "Zweites Bild beim Überfahren"

#: includes/Admin/LayoutSection.php:112
msgid "Accent"
msgstr "Akzent"

#: includes/Admin/LayoutSection.php:113
msgid "Text on accent"
msgstr "Text auf Akzent"

#: includes/Admin/LayoutSection.php:114
msgid "Background"
msgstr "Hintergrund"

#: includes/Admin/LayoutSection.php:115
msgid "Text"
msgstr "Text"

#: includes/Admin/LayoutSection.php:116
msgid "Secondary text"
msgstr "Sekundärtext"

#: includes/Admin/LayoutSection.php:117
msgid "Lines"
msgstr "Linien"

#: includes/Admin/LayoutSection.php:180
msgid "Used when Product cards is on. The product name is always shown first; the other fields follow in the order chosen here."
msgstr "Gilt, wenn Produktkarten an ist. Der Produktname steht immer zuerst; die übrigen Felder folgen in der hier gewählten Reihenfolge."

#: includes/Admin/LayoutSection.php:192
msgid "Designs (the shop default)"
msgstr "Designs (Standard des Shops)"

#: includes/Admin/LayoutSection.php:193
msgid "All products"
msgstr "Alle Produkte"

#: includes/Admin/LayoutSection.php:207
msgid "A Start Token above, or a deeplink= parameter on the short code, takes precedence."
msgstr "Ein Start-Token oben oder ein deeplink=-Parameter am Shortcode hat Vorrang."

#: includes/Admin/LayoutSection.php:232
msgid "Leave a colour empty to use your theme's. A theme can also set these as CSS custom properties, such as --spreadshop-accent; a colour chosen here overrides the theme. The colours apply once at least one layout option is on."
msgstr "Lass eine Farbe leer, um die deines Themes zu verwenden. Ein Theme kann diese Farben auch als CSS Custom Properties setzen, etwa --spreadshop-accent; eine hier gewählte Farbe hat Vorrang vor dem Theme. Die Farben wirken, sobald mindestens eine Layout-Option an ist."

