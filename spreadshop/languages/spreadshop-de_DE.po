#: includes/Admin/LayoutSection.php:164
msgid "Card fields"
msgstr "Kartenfelder"

#: includes/Admin/LayoutSection.php:50
#: includes/Admin/LayoutSection.php:197
msgid "Start page"
msgstr "Startseite"

#: includes/Admin/LayoutSection.php:54
#: includes/Admin/LayoutSection.php:220
