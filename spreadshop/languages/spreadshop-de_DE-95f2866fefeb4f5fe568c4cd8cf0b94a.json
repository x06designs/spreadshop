{"translation-revision-date":"2026-09-25 00:00+0000","generator":"WP-CLI\/2.12.0","source":"js\/admin-card-fields.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"de","plural-forms":"nplurals=2; plural=(n != 1);"},"Chosen card fields":["Gew\u00e4hlte Kartenfelder"],"Add a card field":["Kartenfeld hinzuf\u00fcgen"],"Card fields you can add":["Kartenfelder, die du hinzuf\u00fcgen kannst"],"Type to filter, pick a field with the arrow keys and add it with Enter. Backspace in the empty field removes the last field. On a field, Alt+Arrow Up and Alt+Arrow Down move it.":["Tippe zum Filtern, w\u00e4hle ein Feld mit den Pfeiltasten und f\u00fcge es mit Enter hinzu. R\u00fccktaste im leeren Eingabefeld entfernt das letzte Feld. Auf einem Feld verschieben Alt+Pfeil hoch und Alt+Pfeil runter es."],"Every field is already shown.":["Alle Felder werden bereits angezeigt."],"No field matches.":["Kein Feld passt."],"Move %s up":["%s nach oben verschieben"],"Move %s down":["%s nach unten verschieben"],"Remove %s":["%s entfernen"],"%s added.":["%s hinzugef\u00fcgt."],"%s removed.":["%s entfernt."],"%s is already first.":["%s ist bereits das erste Feld."],"%s is already last.":["%s ist bereits das letzte Feld."],"%1$s moved to position %2$d of %3$d.":["%1$s an Position %2$d von %3$d verschoben."]}}}