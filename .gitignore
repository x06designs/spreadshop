# Dev tooling installs here; never distributed and never committed.
/vendor/
/node_modules/

# Packaging output (the shippable tree is built, not committed).
/dist/

# Local tool overrides. The committed .dist files are the shared baseline.
/phpcs.xml
/phpstan.neon
/phpunit.xml
/.phpcs-cache
/.phpunit.result.cache

# Local debug artifacts (Playwright screenshots, scratch output).
.playwright-mcp/
*.log
