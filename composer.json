{
    "name": "x06designs/spreadshop",
    "description": "Development tooling for the Spreadshop WordPress plugin fork. The shippable plugin is the spreadshop/ directory; nothing here is distributed with it.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "brain/monkey": "^2.6",
        "yoast/wp-test-utils": "^1.2",
        "wp-cli/i18n-command": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@phpstan",
            "@test:unit"
        ],
        "test:unit": "phpunit --testsuite unit",
        "i18n": "bash scripts/i18n.sh",
        "i18n:check": "bash scripts/i18n.sh --check"
    },
    "autoload-dev": {
        "psr-4": {
            "Spreadshop\\Tests\\": "tests/"
        }
    }
}
